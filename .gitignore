# The node ledger IS the run-log deliverable, so real records stay tracked.
# Locally generated validation fixtures must never enter it — they carry a
# placeholder manifest hash and an accepted flag no gate granted. Write those
# to a temporary store instead (see tools/make_blend_parents.py).
logs/nodes/*.json
logs/run.jsonl

# vendored reference material — Shusen Wang recsys course clone (48 PDFs)
RecommenderSystem/

# archived prior runs, regenerated by `cli.py run --fresh`
logs/archive/
