# Copy to .env (git-ignored) and fill in. Never commit the real key.
ANTHROPIC_API_KEY=

# Only needed with an identity-linked API key (one tied to your personal
# Console login rather than issued directly to a workspace) — such a key is
# rejected without this header. Find it at console.anthropic.com under your
# workspace's settings; looks like wrkspc_01AbCdEfGhIjKlMnOpQrStUv. Leave
# blank if your key is a plain workspace key (starts sk-ant-api03-...) and
# already works without it.
ANTHROPIC_WORKSPACE_ID=
